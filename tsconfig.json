{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"jsx": "react-jsx",
		"types": ["bun"]
	},
	"include": ["src", "test", "examples", "e2e", "e2e.config.ts", "scripts/qa", "scripts/make-qc-fixtures.ts"],
	"exclude": ["src/app/studio/web"]
}
